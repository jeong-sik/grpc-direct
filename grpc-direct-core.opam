  "ocaml" {>= "5.1"}
  "dune" {>= "3.0" & >= "3.0"}
  "decompress" {>= "1.5.0"}
  "bigstringaf" {>= "0.9.0"}
  "zstd" {>= "0.4"}
  "odoc" {with-doc}
]
