opam-version: "2.0"
version: "0.2.6"
synopsis: "Protoc plugin for grpc-direct"
description: "Generate OCaml code from .proto files for grpc-direct"
maintainer: ["Jeong-Sik Yun"]
authors: ["Jeong-Sik Yun"]
license: "Apache-2.0"
homepage: "https://github.com/jeong-sik/grpc-direct"
doc: "https://github.com/jeong-sik/grpc-direct"
bug-reports: "https://github.com/jeong-sik/grpc-direct/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.13" & >= "3.13"}
  "ocaml-protoc-plugin" {>= "6.0"}
  "re" {>= "1.10"}
  "bisect_ppx" {with-test & >= "2.8"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/jeong-sik/grpc-direct.git"
